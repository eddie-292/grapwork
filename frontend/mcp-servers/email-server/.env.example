# Email MCP Server 配置文件
# 复制此文件为 .env 并填写你的邮件服务配置

# ==================== SMTP 配置（发送邮件）====================
# SMTP 服务器地址
SMTP_HOST=smtp.gmail.com

# SMTP 端口（587 为 TLS，465 为 SSL）
SMTP_PORT=587

# 是否使用 TLS
SMTP_USE_TLS=true

# SMTP 用户名（通常为完整邮箱地址）
SMTP_USER=your-email@gmail.com

# SMTP 密码
# Gmail 需要使用"应用专用密码"，不是你的 Google 账户密码
# 创建方法：Google 账户 → 安全性 → 两步验证 → 应用专用密码
SMTP_PASSWORD=your-app-password

# 发件人显示名称（可选）
SENDER_NAME=AI Assistant

# ==================== IMAP 配置（接收邮件）====================
# IMAP 服务器地址
IMAP_HOST=imap.gmail.com

# IMAP 端口（993 为 SSL）
IMAP_PORT=993

# IMAP 用户名（通常与 SMTP 相同）
IMAP_USER=your-email@gmail.com

# IMAP 密码（通常与 SMTP 密码相同）
IMAP_PASSWORD=your-app-password

# ==================== 常用邮箱服务配置参考 ====================
#
# Gmail:
#   SMTP: smtp.gmail.com:587 (TLS)
#   IMAP: imap.gmail.com:993
#   注意：需要启用两步验证并创建应用专用密码
#
# Outlook/Hotmail:
#   SMTP: smtp-mail.outlook.com:587 (TLS)
#   IMAP: outlook.office365.com:993
#
# QQ 邮箱:
#   SMTP: smtp.qq.com:587 (TLS) 或 465 (SSL)
#   IMAP: imap.qq.com:993
#   注意：需要使用授权码，不是 QQ 密码
#
# 163 网易邮箱:
#   SMTP: smtp.163.com:465 (SSL, 需设置 SMTP_USE_TLS=false)
#   IMAP: imap.163.com:993
#   注意：需要使用授权码，SMTP_USE_TLS=false（465端口使用直接SSL连接）
#   163 邮箱示例配置：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USE_TLS=false
#   SMTP_USER=your-email@163.com
#   SMTP_PASSWORD=你的授权码
#   IMAP_HOST=imap.163.com
#   IMAP_PORT=993
#   IMAP_USER=your-email@163.com
#   IMAP_PASSWORD=你的授权码
#
# 阿里企业邮箱:
#   SMTP: smtp.qiye.aliyun.com:465 (SSL)
#   IMAP: imap.qiye.aliyun.com:993

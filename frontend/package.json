{
  "name": "prismchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "dev": "vite",
    "dev:renderer": "vite --port 5174",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:renderer": "vue-tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build:electron:watch": "concurrently \"esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --watch\" \"esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --watch\"",
    "electron:dev": "concurrently \"npm run dev:renderer\" \"npm run build:electron:watch\" \"wait-on http://localhost:5174 && wait-on dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron dist-electron/main.cjs\"",
    "electron:build": "npm run build:renderer && npm run build:electron && electron-builder --config electron-builder.json",
    "electron:build:mac": "npm run build:renderer && npm run build:electron && electron-builder --config electron-builder.json --mac",
    "electron:build:win": "npm run build:renderer && npm run build:electron && electron-builder --config electron-builder.json --win",
    "electron:build:all": "npm run build:renderer && npm run build:electron && electron-builder --config electron-builder.json --mac --win"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.25.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.prismchat.desktop",
    "productName": "PrismChat",
    "icon": "build/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
